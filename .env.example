# Generate with: openssl rand -base64 32
NUXT_AUTH_SECRET=
# The address people use to reach Arca (used in invite and share links)
NUXT_BASE_URL=http://localhost:3000

# docker compose only: password for the bundled Postgres
POSTGRES_PASSWORD=

# Local development: omit NUXT_DATABASE_URL to use the in-process PGlite database in ./.data,
# or point it at a Postgres: postgres://arca:arca@localhost:5432/arca
# NUXT_DATABASE_URL=
